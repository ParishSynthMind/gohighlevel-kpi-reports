# GoHighLevel Private Integration token (Settings > Private Integrations), read-only scopes
GHL_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Sub-account (location) ID: the part after /location/ in the GHL app URL
GHL_LOCATION_ID=your-location-id
# Any SQLAlchemy URL. SQLite by default; Postgres works too:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ghl_kpi
DATABASE_URL=sqlite:///ghl_kpi.db
# Optional: Claude writes the weekly summary. Without it a plain template summary is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: report timezone and business name shown on the report
REPORT_TZ=UTC
BUSINESS_NAME=Demo Sub-account
# Optional: alert if the last successful sync is older than this many hours
STALE_AFTER_HOURS=26
# Optional: where alerts and the weekly report go (SMTP). Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=
# Optional: also post sync-failure alerts to a webhook (Slack incoming webhook, etc.)
ALERT_WEBHOOK_URL=
